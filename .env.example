# ============================================================
# DB Diff Viewer 環境変数設定ファイル
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# ============================================================

# -----------------------------------------------
# アプリケーション設定
# -----------------------------------------------
# 暗号化キー（本番環境では必ず強力なランダム文字列に変更してください）
# 生成例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_in_production_use_strong_random_key

# -----------------------------------------------
# ポート設定
# -----------------------------------------------
# フロントエンド公開ポート（HTTPS）
# https://localhost:<FRONTEND_PORT> でアクセスする
FRONTEND_PORT=3000

# バックエンドAPIポート
BACKEND_PORT=8000

# -----------------------------------------------
# HTTPS設定
# -----------------------------------------------
# TLS証明書ディレクトリ
# 空の場合: コンテナ起動時に自己署名証明書を自動生成（localhost専用）
# 本番環境: server.crt と server.key を格納したディレクトリを指定
CERTS_PATH=./certs

# -----------------------------------------------
# SSH鍵ディレクトリ
# -----------------------------------------------
# SSHポートフォワード用秘密鍵を格納するホスト側ディレクトリ
# 例: ~/.ssh/dbdiff_keys
SSH_KEYS_PATH=./ssh_keys
